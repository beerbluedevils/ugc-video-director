{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UGC product job",
  "type": "object",
  "required": [
    "productId",
    "stage",
    "workflowVersion",
    "updatedAt",
    "retryCount",
    "generationAttempts"
  ],
  "properties": {
    "productId": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "stage": {
      "enum": [
        "Preparing",
        "Image Ready",
        "Storyboard Ready",
        "Generating",
        "Video Ready",
        "TikTok Uploading",
        "TikTok Uploaded",
        "TikTok Scheduling",
        "Scheduled — Pending Sheet Update",
        "Completed",
        "Generation Failed",
        "Blocked"
      ]
    },
    "workflowVersion": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "retryCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "generationAttempts": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "attempt",
          "result"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "result": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "testOnly": {
      "type": "boolean"
    },
    "videoPrompt": {
      "type": "string"
    },
    "storyboardGenerationPrompt": {
      "type": "string"
    },
    "productMetadata": {
      "type": "object"
    },
    "summary": {
      "type": [
        "string",
        "object"
      ]
    }
  },
  "additionalProperties": true
}
